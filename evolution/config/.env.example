# Evolution API Configuration
# Copie para evolution/config/ e ajuste conforme necessário

# Server
SERVER_URL=http://localhost:8080
SERVER_PORT=8080
CORS_ORIGIN=*

# Auth
AUTHENTICATION_API_KEY=sua-chave-secreta-aqui
AUTHENTICATION_EXPIRATION=0

# Database
DATABASE_CONNECTION_URI=postgresql://postgres:postgres@postgres:5432/evolution
DATABASE_CONNECTION_CLIENT_NAME=evolution
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_DATA_UPDATE_MESSAGE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true

# Redis
REDIS_URI=redis://redis:6379

# Webhook Global (opcional)
WEBHOOK_GLOBAL_URL=
WEBHOOK_GLOBAL_EVENTS=
WEBHOOK_GLOBAL_ENABLED=false

# RabbitMQ (opcional, para alta escala)
RABBITMQ_ENABLED=false
RABBITMQ_URI=amqp://guest:guest@rabbitmq:5672

# S3/MinIO (opcional, para media)
S3_ENABLED=false
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=

# Logging
LOG_LEVEL=INFO
LOG_COLOR=true

# Instance Settings
DEL_INSTANCE_ON_LOGOUT=false
CLOSE_INSTANCE_ON_LOGOUT=false